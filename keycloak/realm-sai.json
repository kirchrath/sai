{
  "realm": "sai",
  "displayName": "SAI Agenten",
  "enabled": true,
  "sslRequired": "${SAI_KEYCLOAK_SSL_REQUIRED:external}",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["de", "en"],
  "defaultLocale": "de",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Darf Wissensdokumente der Agenten verwalten" },
      { "name": "user", "description": "Darf mit Agenten chatten" }
    ]
  },
  "clients": [
    {
      "clientId": "sai-frontend",
      "name": "SAI Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${SAI_PUBLIC_URL}",
      "baseUrl": "/",
      "redirectUris": ["${SAI_PUBLIC_URL}/*", "http://localhost:5173/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${SAI_PUBLIC_URL}/*##http://localhost:5173/*"
      }
    },
    {
      "clientId": "sai-mcp",
      "name": "SAI MCP-Clients",
      "description": "Client-Credentials fuer externe MCP-Clients des /mcp-Endpoints",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SAI_MCP_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "firstName": "SAI",
      "lastName": "Admin",
      "email": "admin@sai.local",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${SAI_ADMIN_PASSWORD}", "temporary": false }],
      "realmRoles": ["admin", "user"]
    },
    {
      "username": "user",
      "enabled": true,
      "firstName": "SAI",
      "lastName": "Benutzer",
      "email": "user@sai.local",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${SAI_USER_PASSWORD}", "temporary": false }],
      "realmRoles": ["user"]
    },
    {
      "username": "service-account-sai-mcp",
      "enabled": true,
      "serviceAccountClientId": "sai-mcp",
      "realmRoles": ["user"]
    }
  ]
}
