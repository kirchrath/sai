# Kopieren nach .env und Werte anpassen.

# Oeffentliche URL, unter der Browser und MCP-Clients den Stack erreichen (ohne abschliessenden Slash).
# Muss zum Port SAI_HTTP_PORT passen, z.B. http://dockerhost.lan:8080
SAI_PUBLIC_URL=http://localhost:8080
SAI_HTTP_PORT=8080

# Keycloak verlangt standardmaessig HTTPS ausser fuer private Adressen ("external").
# Fuer reinen HTTP-Betrieb unter einem oeffentlichen Hostnamen waere "none" noetig (nicht empfohlen).
SAI_KEYCLOAK_SSL_REQUIRED=external

# Datenbank (gemeinsamer Postgres-Server fuer SAI und Keycloak, getrennte Datenbanken)
SAI_DB_USER=sai
SAI_DB_PASSWORD=bitte-aendern

# Keycloak-Administrator (Admin-Konsole unter $SAI_PUBLIC_URL/auth/admin)
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=bitte-aendern

# Startbenutzer im Realm "sai" (nur beim ersten Realm-Import verwendet)
SAI_ADMIN_PASSWORD=bitte-aendern
SAI_USER_PASSWORD=bitte-aendern

# Client-Secret fuer externe MCP-Clients (Client-Credentials-Flow, Client "sai-mcp")
SAI_MCP_CLIENT_SECRET=bitte-aendern

# LLM-Provider (mindestens einer)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Maximale Upload-Groesse fuer Wissensdokumente in MB
SAI_MAX_UPLOAD_MB=25
